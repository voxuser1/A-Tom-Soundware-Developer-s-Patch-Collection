                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 50.0, 105.0, 528.0, 339.0 ],
                                        "id": "obj-7",
                                        "fontsize": 12.0,
                                        "numinlets": 2,
                                        "fontname": "<Monospaced>",
                                        "numoutlets": 8,
                                        "fontface": 0,
                                        "outlettype": [ "", "", "", "", "", "", "", "" ],
                                        "code": "// =================================================\n// FFT TRACKER CORE 1.8.1 (FINAL FIX)\n// =================================================\n\n// =================================================\n// DATA & HISTORY\n// =================================================\nData spectrum(4096); \nHistory v1_f(0); History v1_a(0);\nHistory v2_f(0); History v2_a(0);\nHistory v3_f(0); History v3_a(0);\nHistory v4_f(0); History v4_a(0);\n\n// =================================================\n// INPUTS\n// =================================================\nraw_mag = in1; \nsync    = in2; // Incoming range is 0...1023!\n\n// INPUT SCALE\nsafe_size = max(256, fft_size); // Protection against 0\nmag = raw_mag * (4.0 / safe_size); \n\n// INDEX CALCULATION\n// Since sync is already 0..1023, we use it directly!\nbin_idx = floor(sync); \n\nhalfsize = safe_size * 0.5;\n\n// =================================================\n// WRITE (Fill Spectrum)\n// =================================================\n// Safety check: Only write if within buffer range\nif (bin_idx < 4096) {\n    poke(spectrum, mag, bin_idx);\n}\n\n// =================================================\n// ANALYSIS (Trigger at end of frame)\n// =================================================\nif (bin_idx >= halfsize - 2 && bin_idx < halfsize + 64) { \n\n    thresh = 0.005; \n    \n    // Reset\n    best1_idx=-1; val1=0;\n    best2_idx=-1; val2=0;\n    best3_idx=-1; val3=0;\n    best4_idx=-1; val4=0;\n\n    // --- SCAN LOOP ---\n    // Start at 4 to ignore DC offset/rumble\n    for (i = 4; i < halfsize - 4; i += 1) {\n        \n        c = peek(spectrum, i);\n        \n        // Bass Bias (Prefer lower frequencies)\n        // Weighting: sqrt(i) creates a gentle curve\n        weight = 10.0 / sqrt(i); \n        c_weighted = c * weight;\n\n        p = peek(spectrum, i-1);\n        n = peek(spectrum, i+1);\n\n        // Peak Detection\n        if (c > thresh && c > p && c > n) {\n            \n            // Highscore (with weighting)\n            if (c_weighted > val1) {\n                val4=val3; best4_idx=best3_idx;\n                val3=val2; best3_idx=best2_idx;\n                val2=val1; best2_idx=best1_idx;\n                val1=c_weighted; best1_idx=i;\n            } \n            else if (c_weighted > val2) {\n                val4=val3; best4_idx=best3_idx;\n                val3=val2; best3_idx=best2_idx;\n                val2=c_weighted; best2_idx=i;\n            } \n            else if (c_weighted > val3) {\n                val4=val3; best4_idx=best3_idx;\n                val3=c_weighted; best3_idx=i;\n            }\n            else if (c_weighted > val4) {\n                val4=c_weighted; best4_idx=i;\n            }\n        }\n    }\n\n    // --- CLEANUP (Shift up too-close peaks) ---\n    min_dist = 3; \n\n    // Conflict 2 vs 1\n    if (abs(best2_idx - best1_idx) < min_dist) {\n        best2_idx = best3_idx; val2 = val3;\n        best3_idx = best4_idx; val3 = val4;\n        best4_idx = -1;        val4 = 0;\n    }\n    // Conflict 3 vs 1/2\n    if (abs(best3_idx - best1_idx) < min_dist || abs(best3_idx - best2_idx) < min_dist) {\n        best3_idx = best4_idx; val3 = val4;\n        best4_idx = -1;        val4 = 0;\n    }\n    // Conflict 4\n    if (abs(best4_idx - best1_idx) < min_dist || abs(best4_idx - best2_idx) < min_dist || abs(best4_idx - best3_idx) < min_dist) {\n        best4_idx = -1; \n    }\n\n    // --- OUTPUT CALCULATION ---\n    hz_bin = samplerate / safe_size;\n    smooth = 0.3; \n\n    // Voice 1\n    if (best1_idx > 0) {\n        idx = best1_idx;\n        real_amp = peek(spectrum, idx); // Use real amplitude!\n        p = peek(spectrum, idx-1); c = peek(spectrum, idx); n = peek(spectrum, idx+1);\n        denom = p - 2 * c + n;\n        delta = (abs(denom) > 1e-6) ? 0.5 * (p - n) / denom : 0;\n        v1_f += ((idx + delta) * hz_bin - v1_f) * smooth;\n        v1_a = real_amp;\n    } else { v1_a *= 0.8; }\n\n    // Voice 2\n    if (best2_idx > 0) {\n        idx = best2_idx;\n        real_amp = peek(spectrum, idx);\n        p = peek(spectrum, idx-1); c = peek(spectrum, idx); n = peek(spectrum, idx+1);\n        denom = p - 2 * c + n;\n        delta = (abs(denom) > 1e-6) ? 0.5 * (p - n) / denom : 0;\n        v2_f += ((idx + delta) * hz_bin - v2_f) * smooth;\n        v2_a = real_amp;\n    } else { v2_a *= 0.8; }\n    \n    // Voice 3\n    if (best3_idx > 0) {\n        idx = best3_idx;\n        real_amp = peek(spectrum, idx);\n        p = peek(spectrum, idx-1); c = peek(spectrum, idx); n = peek(spectrum, idx+1);\n        denom = p - 2 * c + n;\n        delta = (abs(denom) > 1e-6) ? 0.5 * (p - n) / denom : 0;\n        v3_f += ((idx + delta) * hz_bin - v3_f) * smooth;\n        v3_a = real_amp;\n    } else { v3_a *= 0.8; }\n\n    // Voice 4\n    if (best4_idx > 0) {\n        idx = best4_idx;\n        real_amp = peek(spectrum, idx);\n        p = peek(spectrum, idx-1); c = peek(spectrum, idx); n = peek(spectrum, idx+1);\n        denom = p - 2 * c + n;\n        delta = (abs(denom) > 1e-6) ? 0.5 * (p - n) / denom : 0;\n        v4_f += ((idx + delta) * hz_bin - v4_f) * smooth;\n        v4_a = real_amp;\n    } else { v4_a *= 0.8; }\n}\n\nout1 = v1_f; out2 = v1_a;\nout3 = v2_f; out4 = v2_a;\nout5 = v3_f; out6 = v3_a;\nout7 = v4_f; out8 = v4_a;"
                                    }
                                },
