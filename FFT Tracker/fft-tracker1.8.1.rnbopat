                                        "numoutlets": 0
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "out 2",
                                        "patching_rect": [ 122.71428571428572, 489.0, 35.0, 22.0 ],
                                        "id": "obj-8",
                                        "numinlets": 1,
