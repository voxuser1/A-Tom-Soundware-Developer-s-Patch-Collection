                    "rnbo_classname": "gen~",
                    "rnbo_extra_attributes": {
                        "exposeparams": 0,
                        "gencode": "Param fft_size(1024);\nData spectrum(4096, 1);\nHistory v1_f(0);\nHistory v1_a(0);\nHistory v2_f(0);\nHistory v2_a(0);\nHistory v3_f(0);\nHistory v3_a(0);\nHistory v4_f(0);\nHistory v4_a(0);\nout9 = fft_size;\nsafe_size = max(256, fft_size);\nmag = in1 * (4 / safe_size);\nbin_idx = floor(in2);\nhalfsize = safe_size * 0.5;\nif(bin_idx < 4096) {\n\tpoke(spectrum, mag, bin_idx, 0, 0);\n}\nif((bin_idx >= (halfsize - 2)) && (bin_idx < (halfsize + 64))) {\n\tbest1_idx = -1;\n\tval1 = 0;\n\tbest2_idx = -1;\n\tval2 = 0;\n\tbest3_idx = -1;\n\tval3 = 0;\n\tbest4_idx = -1;\n\tval4 = 0;\n\tfor(i = 4; i < (halfsize - 4); i = i + 1) {\n\t\tc = peek(spectrum, i, 0);\n\t\tweight = 10 / (sqrt(i));\n\t\tc_weighted = c * weight;\n\t\tp = peek(spectrum, i - 1, 0);\n\t\tn = peek(spectrum, i + 1, 0);\n\t\tif((((c > 0.005) && (c > p))) && (c > n)) {\n\t\t\tif(c_weighted > val1) {\n\t\t\t\tval4 = val3;\n\t\t\t\tbest4_idx = best3_idx;\n\t\t\t\tval3 = val2;\n\t\t\t\tbest3_idx = best2_idx;\n\t\t\t\tval2 = val1;\n\t\t\t\tbest2_idx = best1_idx;\n\t\t\t\tval1 = c_weighted;\n\t\t\t\tbest1_idx = i;\n\t\t\t}\n\t\t\telse if(c_weighted > val2) {\n\t\t\t\tval4 = val3;\n\t\t\t\tbest4_idx = best3_idx;\n\t\t\t\tval3 = val2;\n\t\t\t\tbest3_idx = best2_idx;\n\t\t\t\tval2 = c_weighted;\n\t\t\t\tbest2_idx = i;\n\t\t\t}\n\t\t\telse if(c_weighted > val3) {\n\t\t\t\tval4 = val3;\n\t\t\t\tbest4_idx = best3_idx;\n\t\t\t\tval3 = c_weighted;\n\t\t\t\tbest3_idx = i;\n\t\t\t}\n\t\t\telse if(c_weighted > val4) {\n\t\t\t\tval4 = c_weighted;\n\t\t\t\tbest4_idx = i;\n\t\t\t}\n\t\t}\n\t}\n\tif((abs(best2_idx - best1_idx)) < 3) {\n\t\tbest2_idx = best3_idx;\n\t\tval2 = val3;\n\t\tbest3_idx = best4_idx;\n\t\tval3 = val4;\n\t\tbest4_idx = -1;\n\t\tval4 = 0;\n\t}\n\tif(((abs(best3_idx - best1_idx)) < 3) || ((abs(best3_idx - best2_idx)) < 3)) {\n\t\tbest3_idx = best4_idx;\n\t\tval3 = val4;\n\t\tbest4_idx = -1;\n\t\tval4 = 0;\n\t}\n\tif(((((abs(best4_idx - best1_idx)) < 3) || ((abs(best4_idx - best2_idx)) < 3))) || ((abs(best4_idx - best3_idx)) < 3)) {\n\t\tbest4_idx = -1;\n\t}\n\thz_bin = samplerate / safe_size;\n\tif(best1_idx > 0) {\n\t\tidx = best1_idx;\n\t\treal_amp = peek(spectrum, idx, 0);\n\t\tp = peek(spectrum, idx - 1, 0);\n\t\tc = peek(spectrum, idx, 0);\n\t\tn = peek(spectrum, idx + 1, 0);\n\t\tdenom = (p - (2 * c)) + n;\n\t\tdelta = (abs(denom)) > 1e-06 ? ((0.5 * ((p - n)))) / denom : 0;\n\t\tv1_f = v1_f + ((((((idx + delta)) * hz_bin) - v1_f)) * 0.3);\n\t\tv1_a = real_amp;\n\t}\n\telse {\n\t\tv1_a = v1_a * 0.8;\n\t}\n\tif(best2_idx > 0) {\n\t\tidx = best2_idx;\n\t\treal_amp = peek(spectrum, idx, 0);\n\t\tp = peek(spectrum, idx - 1, 0);\n\t\tc = peek(spectrum, idx, 0);\n\t\tn = peek(spectrum, idx + 1, 0);\n\t\tdenom = (p - (2 * c)) + n;\n\t\tdelta = (abs(denom)) > 1e-06 ? ((0.5 * ((p - n)))) / denom : 0;\n\t\tv2_f = v2_f + ((((((idx + delta)) * hz_bin) - v2_f)) * 0.3);\n\t\tv2_a = real_amp;\n\t}\n\telse {\n\t\tv2_a = v2_a * 0.8;\n\t}\n\tif(best3_idx > 0) {\n\t\tidx = best3_idx;\n\t\treal_amp = peek(spectrum, idx, 0);\n\t\tp = peek(spectrum, idx - 1, 0);\n\t\tc = peek(spectrum, idx, 0);\n\t\tn = peek(spectrum, idx + 1, 0);\n\t\tdenom = (p - (2 * c)) + n;\n\t\tdelta = (abs(denom)) > 1e-06 ? ((0.5 * ((p - n)))) / denom : 0;\n\t\tv3_f = v3_f + ((((((idx + delta)) * hz_bin) - v3_f)) * 0.3);\n\t\tv3_a = real_amp;\n\t}\n\telse {\n\t\tv3_a = v3_a * 0.8;\n\t}\n\tif(best4_idx > 0) {\n\t\tidx = best4_idx;\n\t\treal_amp = peek(spectrum, idx, 0);\n\t\tp = peek(spectrum, idx - 1, 0);\n\t\tc = peek(spectrum, idx, 0);\n\t\tn = peek(spectrum, idx + 1, 0);\n\t\tdenom = (p - (2 * c)) + n;\n\t\tdelta = (abs(denom)) > 1e-06 ? ((0.5 * ((p - n)))) / denom : 0;\n\t\tv4_f = v4_f + ((((((idx + delta)) * hz_bin) - v4_f)) * 0.3);\n\t\tv4_a = real_amp;\n\t}\n\telse {\n\t\tv4_a = v4_a * 0.8;\n\t}\n}\nexpr_1 = v1_f;\nexpr_2 = v1_a;\nexpr_3 = v2_f;\nexpr_4 = v2_a;\nexpr_5 = v3_f;\nexpr_6 = v3_a;\nexpr_7 = v4_f;\nexpr_8 = v4_a;\nout3 = expr_3;\nout2 = expr_2;\nout8 = expr_8;\nout5 = expr_5;\nout6 = expr_6;\nout1 = expr_1;\nout4 = expr_4;\nout7 = expr_7;",
