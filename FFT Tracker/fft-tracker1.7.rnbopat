                                        "id": "obj-25",
                                        "fontsize": 12.0,
                                        "outlettype": [ "", "", "", "", "", "" ],
                                        "fontname": "<Monospaced>",
                                        "code": "// =================================================\n// HISTORY (must come first)\n// =================================================\nHistory h2_f(0);\nHistory h3_f(0);\nHistory h4_f(0);\n\nHistory h2_a(0);\nHistory h3_a(0);\nHistory h4_a(0);\n\n// =================================================\n// DATA\n// =================================================\nData spectrum(1024);\n\n// =================================================\n// INPUTS\n// =================================================\nmag        = in1;\nbin_f      = in2;\nfund_freq  = in3;   // Hz from Box 1\nhas_fund   = in4;   // 0 / 1 from Box 1\n\nbin_idx  = floor(bin_f + 0.5);\nhalfsize = framesize * 0.5;\n\n// =================================================\n// COLLECT SPECTRUM\n// =================================================\nif (bin_idx >= 0 && bin_idx < halfsize && bin_idx < 1024) {\n    poke(spectrum, mag, bin_idx);\n}\n\n// =================================================\n// DETECT FRAME END\n// =================================================\nframe_end = (bin_idx >= halfsize - 1);\n\n// =================================================\n// PROCESS ONLY AT FRAME END\n// =================================================\nif (frame_end && has_fund && fund_freq > 0) {\n\n    // ===============================\n    // EXPECTED HARMONICS\n    // ===============================\n    f2 = fund_freq * 2;\n    f3 = fund_freq * 3;\n    f4 = fund_freq * 4;\n\n    // ===============================\n    // Hz -> Bin\n    // ===============================\n    b2 = round(f2 * framesize / samplerate);\n    b3 = round(f3 * framesize / samplerate);\n    b4 = round(f4 * framesize / samplerate);\n\n    // ===============================\n    // LOCAL ENERGY (±1 Bin)\n    // ===============================\n    h2 = 0;\n    if (b2 > 1 && b2 < halfsize - 1) {\n        h2 = max(\n            peek(spectrum, b2),\n            max(peek(spectrum, b2 - 1), peek(spectrum, b2 + 1))\n        );\n    }\n\n    h3 = 0;\n    if (b3 > 1 && b3 < halfsize - 1) {\n        h3 = max(\n            peek(spectrum, b3),\n            max(peek(spectrum, b3 - 1), peek(spectrum, b3 + 1))\n        );\n    }\n\n    h4 = 0;\n    if (b4 > 1 && b4 < halfsize - 1) {\n        h4 = max(\n            peek(spectrum, b4),\n            max(peek(spectrum, b4 - 1), peek(spectrum, b4 + 1))\n        );\n    }\n\n    // ===============================\n    // SMOOTHING\n    // ===============================\n    smooth = 0.2;\n\n    h2_f = h2_f + (f2 - h2_f) * smooth;\n    h3_f = h3_f + (f3 - h3_f) * smooth;\n    h4_f = h4_f + (f4 - h4_f) * smooth;\n\n    h2_a = h2_a + (h2 - h2_a) * smooth;\n    h3_a = h3_a + (h3 - h3_a) * smooth;\n    h4_a = h4_a + (h4 - h4_a) * smooth;\n}\nelse if (frame_end) {\n    // ===============================\n    // NO FUNDAMENTAL / SILENCE\n    // → RESET ALL TO 0 IMMEDIATELY\n    // ===============================\n    h2_f = 0;\n    h3_f = 0;\n    h4_f = 0;\n\n    h2_a = 0;\n    h3_a = 0;\n    h4_a = 0;\n}\n\n// =================================================\n// OUTPUTS\n// =================================================\nout1 = h2_f;\nout2 = h2_a;\n\nout3 = h3_f;\nout4 = h3_a;\n\nout5 = h4_f;\nout6 = h4_a;"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "out 2",
                                        "patching_rect": [ 244.3222234249115, 1085.3333656787872, 60.00000178813934, 22.0 ],
                                        "numinlets": 1,
                                        "numoutlets": 0,
                                        "id": "obj-21"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "param framesize 1024",
                                        "patching_rect": [ 1330.1, 100.00000298023224, 128.0, 22.0 ],
                                        "numinlets": 0,
                                        "numoutlets": 1,
                                        "id": "obj-18",
                                        "outlettype": [ "" ]
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 25.83333420753479, 108.00000321865082, 674.4666676521301, 955.2000142335892 ],
                                        "numinlets": 2,
                                        "fontface": 0,
                                        "numoutlets": 4,
                                        "id": "obj-8",
                                        "fontsize": 12.0,
                                        "outlettype": [ "", "", "", "" ],
                                        "fontname": "<Monospaced>",
                                        "code": "// =================================================\n// HISTORY\n// =================================================\nHistory current_max_mag(0);\nHistory current_best_bin(0);\n\nHistory output_freq(0);\nHistory output_mag(0);\nHistory stable_counter(0);\n\n// Median Filter History\nHistory hist_f1(0);\nHistory hist_f2(0);\nHistory hist_f3(0);\n\n// =================================================\n// DATA (1024 is sufficient for your framesize)\n// =================================================\nData spectrum(1024);\n\n// =================================================\n// SETTINGS\n// =================================================\nlock_frames     = 3;      \nsub_thresh      = 0.15;\noct_tol         = 15;\nsustain_smooth  = 0.15;   \n\n// =================================================\n// INPUTS\n// =================================================\nmag   = in1;\nbin_f = in2;\n\nbin_idx  = floor(bin_f + 0.5);\nhalfsize = framesize * 0.5;\n\n// =================================================\n// RESET\n// =================================================\nif (bin_idx <= 0) {\n    current_max_mag  = 0;\n    current_best_bin = 0;\n}\n\n// =================================================\n// RECORD SPECTRUM\n// =================================================\nif (bin_idx >= 1 && bin_idx < halfsize && bin_idx < 1024) {\n    \n    poke(spectrum, mag, bin_idx);\n\n    // Peak search starting at Bin 2 (Filters DC offset/noise in Bin 0 & 1)\n    if (bin_idx >= 2) { \n        if (mag > current_max_mag) {\n            current_max_mag  = mag;\n            current_best_bin = bin_idx;\n        }\n    }\n}\n\n// =================================================\n// FRAME END LOGIC\n// =================================================\nif (bin_idx >= (halfsize - 1)) {\n\n    // Default: Sample & Hold (in case we calculate immediately)\n    calc_freq = output_freq;\n\n    if (current_max_mag > noisethresh) {\n\n        p = current_best_bin;\n\n        // =========================\n        // PHASE 1: ATTACK (Aggressive & Fast)\n        // =========================\n        if (stable_counter < lock_frames) {\n\n            // FIX FOR 1024: Check starting at Bin 2 (E2/A2 detection)\n            if (p >= 2) {\n                idx_sub = floor(p * 0.5);\n                \n                if (idx_sub >= 1) {\n                    a = peek(spectrum, idx_sub - 1);\n                    b = peek(spectrum, idx_sub);\n                    c = peek(spectrum, idx_sub + 1);\n\n                    max_sub = max(b, max(a, c));\n                    \n                    if (p < 12) max_sub *= bass_bias;\n\n                    if (max_sub > current_max_mag * sub_thresh) {\n                        if (a > b && a > c)      p = idx_sub - 1;\n                        else if (c > b)          p = idx_sub + 1;\n                        else                     p = idx_sub;\n                    }\n                }\n            }\n            \n            // Interpolation\n            if (p >= 2 && p < halfsize - 1) {\n                alpha = 0; \n                if (p > 1) alpha = peek(spectrum, p - 1);\n                beta  = peek(spectrum, p);\n                gamma = peek(spectrum, p + 1);\n                \n                denom = alpha - 2 * beta + gamma;\n                delta = 0;\n                if (abs(denom) > 0.000001) delta = 0.5 * (alpha - gamma) / denom;\n                \n                if (delta > 0.5) delta = 0.5;\n                if (delta < -0.5) delta = -0.5;\n                \n                calc_freq = (p + delta) * samplerate / framesize;\n            } else {\n                calc_freq = p * samplerate / framesize;\n            }\n\n            output_freq = calc_freq;\n            stable_counter += 1;\n        }\n\n        // =========================\n        // PHASE 2: SUSTAIN (Harmonic & Smooth)\n        // =========================\n        else {\n            score_p  = peek(spectrum, p);\n            score_lo = 0;\n            score_hi = 0;\n\n            if (p >= 4) score_lo = peek(spectrum, floor(p * 0.5)) * 0.8;\n            if (p * 2 < halfsize) score_hi = peek(spectrum, p * 2) * 0.6;\n\n            if (score_lo > score_p && score_lo > score_hi) {\n                p = floor(p * 0.5);\n            } else if (score_hi > score_p) {\n                p = p * 2;\n            }\n\n            // Interpolation\n            if (p >= 2 && p < halfsize - 1) {\n                alpha = 0; \n                if (p > 1) alpha = peek(spectrum, p - 1);\n                beta  = peek(spectrum, p);\n                gamma = peek(spectrum, p + 1);\n\n                denom = alpha - 2 * beta + gamma;\n                delta = 0;\n                if (abs(denom) > 0.000001) delta = 0.5 * (alpha - gamma) / denom;\n\n                if (delta > 0.5) delta = 0.5;\n                if (delta < -0.5) delta = -0.5;\n\n                calc_freq = (p + delta) * samplerate / framesize;\n            } else {\n                calc_freq = p * samplerate / framesize;\n            }\n\n            output_freq = output_freq + (calc_freq - output_freq) * sustain_smooth;\n            calc_freq = output_freq; \n            \n            stable_counter += 1;\n        }\n\n        output_mag = current_max_mag;\n    }\n    else {\n        // --- SILENCE DETECTED ---\n        output_mag = 0;\n        stable_counter = 0;\n        \n        // NEW: Immediate internal reset to 0 so nothing gets stuck\n        output_freq = 0;\n        calc_freq = 0;\n    }\n\n    // =========================\n    // C: MEDIAN FILTER\n    // =========================\n    hist_f3 = hist_f2;\n    hist_f2 = hist_f1;\n    hist_f1 = calc_freq;\n\n    a = hist_f1; b = hist_f2; c = hist_f3;\n\n    median = b;\n    if ((a > b) != (a > c))      median = a;\n    else if ((b > a) != (b > c)) median = b;\n    else                         median = c;\n\n    if (output_mag > 0) {\n        output_freq = median;\n    }\n}\n\n// =================================================\n// OUTPUT\n// =================================================\nfinal_mag = output_mag;\n\n// Attack Mute\nif (stable_counter < lock_frames) final_mag = 0;\n\n// NEW: If gate closed (silence), force frequency to 0!\nfinal_freq = output_freq;\nif (final_mag == 0) {\n    final_freq = 0;\n}\n\n// =================================================\n// FUNDAMENTAL STATUS (NEW!)\n// =================================================\nhas_fundamental = 0;\n\nif (stable_counter >= lock_frames && final_mag > 0) {\n    has_fundamental = 1;\n}\n\n\nout1 = final_freq;\nout2 = final_mag;\nout3 = stable_counter;\nout4 = has_fundamental;"
                                    }
                                },
