                    "id": "obj-26",
                    "maxclass": "newobj",
                    "numinlets": 2,
                    "numoutlets": 11,
                    "outlettype": [ "signal", "signal", "signal", "signal", "signal", "signal", "signal", "signal", "signal", "signal", "signal" ],
                    "patching_rect": [ 74.0, 437.3333463668823, 1473.3333772420883, 23.0 ],
                    "rnbo_classname": "gen~",
                    "rnbo_extra_attributes": {
                        "bass_bias": 0.0,
