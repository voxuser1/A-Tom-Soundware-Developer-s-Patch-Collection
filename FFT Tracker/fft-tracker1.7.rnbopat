            {
                "box": {
                    "genpatcher": {
                        "patcher": {
                            "fileversion": 1,
                            "appversion": {
                                "major": 9,
                                "minor": 1,
                                "revision": 0,
                                "architecture": "x64",
                                "modernui": 1
                            },
                            "classnamespace": "dsp.gen",
                            "rect": [ 34.0, 100.0, 1444.0, 791.0 ],
                            "boxes": [
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "param bass_bias",
                                        "patching_rect": [ 1189.3333687782288, 100.00000298023224, 100.0, 22.0 ],
                                        "numinlets": 0,
                                        "numoutlets": 1,
                                        "id": "obj-3",
                                        "outlettype": [ "" ]
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "out 11",
                                        "patching_rect": [ 1036.000030875206, 1542.666712641716, 41.0, 22.0 ],
                                        "numinlets": 1,
                                        "numoutlets": 0,
                                        "id": "obj-31"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 1036.000030875206, 1066.6666984558105, 462.6666804552078, 401.3333452939987 ],
                                        "numinlets": 2,
                                        "fontface": 0,
                                        "numoutlets": 1,
                                        "id": "obj-29",
                                        "fontsize": 12.0,
                                        "outlettype": [ "" ],
                                        "fontname": "<Monospaced>",
                                        "code": "// =================================================\n// HISTORY\n// =================================================\nHistory tone_val(0);\n\n// =================================================\n// INPUTS\n// =================================================\nstable  = in1;\nhasfund = in2;\n\n// =================================================\n// FIXED CONSTANTS\n// =================================================\ntone_frames   = 80;\nattack_speed  = 0.02;\nrelease_speed = 0.05;\n\n// =================================================\n// LOGIC\n// =================================================\n\n// 1. Pre-define variables (Helps the compiler)\ntarget = 0;\n\n// 2. Clamp (Limit to Max)\nsc = min(stable, tone_frames);\n\n// 3. Calculate target value (The Ramp)\nif (hasfund) {\n    // Calculate ratio (0.0 to 1.0)\n    t = sc / tone_frames;\n    \n    // Quadratic curve (Smooth start)\n    target = t * t; \n} else {\n    // If no fundamental exists, target immediately 0\n    target = 0;\n}\n\n// 4. Smoothing (Attack / Release Logic)\n// If target is higher than current -> Attack\n// Else -> Release\nspeed = (target > tone_val) ? attack_speed : release_speed;\n\ntone_val = tone_val + (target - tone_val) * speed;\n\n// 5. Safety Clamp at the end\nif (tone_val < 0) tone_val = 0;\nif (tone_val > 1) tone_val = 1;\n\n// =================================================\n// OUTPUT\n// =================================================\nout1 = tone_val;"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "comment",
                                        "text": "Test Out",
                                        "patching_rect": [ 1231.8334075212479, 141.00000417232513, 68.4999612569809, 20.0 ],
                                        "numinlets": 1,
                                        "numoutlets": 0,
                                        "id": "obj-19"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "comment",
                                        "text": "Backup Box2",
                                        "patching_rect": [ 669.3333532810211, 1196.0000356435776, 150.0, 20.0 ],
                                        "numinlets": 1,
                                        "numoutlets": 0,
                                        "id": "obj-14"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 669.3333532810211, 1230.6667033433914, 340.0, 200.0 ],
                                        "numinlets": 4,
                                        "fontface": 0,
                                        "numoutlets": 6,
                                        "id": "obj-13",
                                        "fontsize": 12.0,
                                        "outlettype": [ "", "", "", "", "", "" ],
                                        "fontname": "<Monospaced>",
                                        "code": "// =================================================\n// HISTORY (muss zuerst kommen)\n// =================================================\nHistory h2_f(0);\nHistory h3_f(0);\nHistory h4_f(0);\n\nHistory h2_a(0);\nHistory h3_a(0);\nHistory h4_a(0);\n\n// =================================================\n// DATA\n// =================================================\nData spectrum(1024);\n\n// =================================================\n// INPUTS\n// =================================================\nmag        = in1;\nbin_f      = in2;\nfund_freq  = in3;   // Hz\nhas_fund   = in4;   // 0 / 1\n\nbin_idx  = floor(bin_f + 0.5);\nhalfsize = framesize * 0.5;\n\n// =================================================\n// SPEKTRUM SAMMELN\n// =================================================\nif (bin_idx >= 0 && bin_idx < halfsize && bin_idx < 1024) {\n    poke(spectrum, mag, bin_idx);\n}\n\n// =================================================\n// FRAME-ENDE ERKENNEN\n// =================================================\nframe_end = (bin_idx >= halfsize - 1);\n\n// =================================================\n// NUR AM FRAME-ENDE ARBEITEN\n// =================================================\nif (frame_end && has_fund && fund_freq > 0) {\n\n    // ===============================\n    // ERWARTETE OBERTOENE\n    // ===============================\n    f2 = fund_freq * 2;\n    f3 = fund_freq * 3;\n    f4 = fund_freq * 4;\n\n    // ===============================\n    // Hz -> Bin\n    // ===============================\n    b2 = round(f2 * framesize / samplerate);\n    b3 = round(f3 * framesize / samplerate);\n    b4 = round(f4 * framesize / samplerate);\n\n    // ===============================\n    // LOKALE ENERGIE (±1 Bin)\n    // ===============================\n    h2 = 0;\n    if (b2 > 1 && b2 < halfsize-1) {\n        h2 = max(\n            peek(spectrum, b2),\n            max(peek(spectrum, b2-1), peek(spectrum, b2+1))\n        );\n    }\n\n    h3 = 0;\n    if (b3 > 1 && b3 < halfsize-1) {\n        h3 = max(\n            peek(spectrum, b3),\n            max(peek(spectrum, b3-1), peek(spectrum, b3+1))\n        );\n    }\n\n    h4 = 0;\n    if (b4 > 1 && b4 < halfsize-1) {\n        h4 = max(\n            peek(spectrum, b4),\n            max(peek(spectrum, b4-1), peek(spectrum, b4+1))\n        );\n    }\n\n    // ===============================\n    // SANFTE GLÄTTUNG (wie FluCoMa)\n    // ===============================\n    smooth = 0.2;\n\n    h2_f = h2_f + (f2 - h2_f) * smooth;\n    h3_f = h3_f + (f3 - h3_f) * smooth;\n    h4_f = h4_f + (f4 - h4_f) * smooth;\n\n    h2_a = h2_a + (h2 - h2_a) * smooth;\n    h3_a = h3_a + (h3 - h3_a) * smooth;\n    h4_a = h4_a + (h4 - h4_a) * smooth;\n}\n\n// =================================================\n// OUTPUTS\n// =================================================\nout1 = h2_f;\nout2 = h2_a;\n\nout3 = h3_f;\nout4 = h3_a;\n\nout5 = h4_f;\nout6 = h4_a;\n"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "out 8",
                                        "patching_rect": [ 1479.5, 952.0000283718109, 35.0, 22.0 ],
                                        "numinlets": 1,
                                        "numoutlets": 0,
                                        "id": "obj-27"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "out 7",
                                        "patching_rect": [ 1330.1, 952.0000283718109, 35.0, 22.0 ],
                                        "numinlets": 1,
                                        "numoutlets": 0,
                                        "id": "obj-26"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "out 6",
                                        "patching_rect": [ 1180.7, 952.0000283718109, 35.0, 22.0 ],
                                        "numinlets": 1,
                                        "numoutlets": 0,
                                        "id": "obj-23"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "out 5",
                                        "patching_rect": [ 1031.3, 946.6666948795319, 35.0, 22.0 ],
                                        "numinlets": 1,
                                        "numoutlets": 0,
                                        "id": "obj-22"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "comment",
                                        "text": "Backup Box1",
                                        "patching_rect": [ 20.000000596046448, 1196.0000356435776, 150.0, 20.0 ],
                                        "numinlets": 1,
                                        "numoutlets": 0,
                                        "id": "obj-20"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 20.000000596046448, 1230.6667033433914, 640.0000190734863, 977.3333624601364 ],
                                        "numinlets": 2,
                                        "fontface": 0,
                                        "numoutlets": 4,
                                        "id": "obj-15",
                                        "fontsize": 12.0,
                                        "outlettype": [ "", "", "", "" ],
                                        "fontname": "<Monospaced>",
                                        "code": "// =================================================\n// HISTORY\n// =================================================\nHistory current_max_mag(0);\nHistory current_best_bin(0);\n\nHistory output_freq(0);\nHistory output_mag(0);\nHistory stable_counter(0);\n\n// Median Filter History\nHistory hist_f1(0);\nHistory hist_f2(0);\nHistory hist_f3(0);\n\n// =================================================\n// DATA (1024 reicht für deine Framesize)\n// =================================================\nData spectrum(1024);\n\n// =================================================\n// EINSTELLUNGEN\n// =================================================\nlock_frames     = 3;      \nsub_thresh      = 0.15;\noct_tol         = 15;\nsustain_smooth  = 0.15;   \n\n// =================================================\n// INPUTS\n// =================================================\nmag   = in1;\nbin_f = in2;\n\nbin_idx  = floor(bin_f + 0.5);\nhalfsize = framesize * 0.5;\n\n// =================================================\n// RESETnein \n// =================================================\nif (bin_idx <= 0) {\n    current_max_mag  = 0;\n    current_best_bin = 0;\n}\n\n// =================================================\n// SPEKTRUM AUFZEICHNEN\n// =================================================\nif (bin_idx >= 1 && bin_idx < halfsize && bin_idx < 1024) {\n    \n    poke(spectrum, mag, bin_idx);\n\n    // Peak-Suche ab Bin 2 (Filtert DC-Offset/Rauschen in Bin 0 & 1)\n    if (bin_idx >= 2) { \n        if (mag > current_max_mag) {\n            current_max_mag  = mag;\n            current_best_bin = bin_idx;\n        }\n    }\n}\n\n// =================================================\n// FRAME-ENDE LOGIK\n// =================================================\nif (bin_idx >= (halfsize - 1)) {\n\n    // Default: Sample & Hold (falls wir gleich rechnen)\n    calc_freq = output_freq;\n\n    if (current_max_mag > noisethresh) {\n\n        p = current_best_bin;\n\n        // =========================\n        // PHASE 1: ATTACK (Aggressiv & Schnell)\n        // =========================\n        if (stable_counter < lock_frames) {\n\n            // FIX FÜR 1024: Prüfung ab Bin 2 (E2/A2 Erkennung)\n            if (p >= 2) {\n                idx_sub = floor(p * 0.5);\n                \n                if (idx_sub >= 1) {\n                    a = peek(spectrum, idx_sub - 1);\n                    b = peek(spectrum, idx_sub);\n                    c = peek(spectrum, idx_sub + 1);\n\n                    max_sub = max(b, max(a, c));\n                    \n                    if (p < 12) max_sub *= bass_bias;\n\n                    if (max_sub > current_max_mag * sub_thresh) {\n                        if (a > b && a > c)      p = idx_sub - 1;\n                        else if (c > b)          p = idx_sub + 1;\n                        else                     p = idx_sub;\n                    }\n                }\n            }\n            \n            // Interpolation\n            if (p >= 2 && p < halfsize - 1) {\n                alpha = 0; \n                if (p > 1) alpha = peek(spectrum, p - 1);\n                beta  = peek(spectrum, p);\n                gamma = peek(spectrum, p + 1);\n                \n                denom = alpha - 2 * beta + gamma;\n                delta = 0;\n                if (abs(denom) > 0.000001) delta = 0.5 * (alpha - gamma) / denom;\n                \n                if (delta > 0.5) delta = 0.5;\n                if (delta < -0.5) delta = -0.5;\n                \n                calc_freq = (p + delta) * samplerate / framesize;\n            } else {\n                calc_freq = p * samplerate / framesize;\n            }\n\n            output_freq = calc_freq;\n            stable_counter += 1;\n        }\n\n        // =========================\n        // PHASE 2: SUSTAIN (Harmonisch & Glatt)\n        // =========================\n        else {\n            score_p  = peek(spectrum, p);\n            score_lo = 0;\n            score_hi = 0;\n\n            if (p >= 4) score_lo = peek(spectrum, floor(p * 0.5)) * 0.8;\n            if (p * 2 < halfsize) score_hi = peek(spectrum, p * 2) * 0.6;\n\n            if (score_lo > score_p && score_lo > score_hi) {\n                p = floor(p * 0.5);\n            } else if (score_hi > score_p) {\n                p = p * 2;\n            }\n\n            // Interpolation\n            if (p >= 2 && p < halfsize - 1) {\n                alpha = 0; \n                if (p > 1) alpha = peek(spectrum, p - 1);\n                beta  = peek(spectrum, p);\n                gamma = peek(spectrum, p + 1);\n\n                denom = alpha - 2 * beta + gamma;\n                delta = 0;\n                if (abs(denom) > 0.000001) delta = 0.5 * (alpha - gamma) / denom;\n\n                if (delta > 0.5) delta = 0.5;\n                if (delta < -0.5) delta = -0.5;\n\n                calc_freq = (p + delta) * samplerate / framesize;\n            } else {\n                calc_freq = p * samplerate / framesize;\n            }\n\n            output_freq = output_freq + (calc_freq - output_freq) * sustain_smooth;\n            calc_freq = output_freq; \n            \n            stable_counter += 1;\n        }\n\n        output_mag = current_max_mag;\n    }\n    else {\n        // --- STILLE ERKANNT ---\n        output_mag = 0;\n        stable_counter = 0;\n        \n        // NEU: Sofort interner Reset auf 0, damit nichts hängen bleibt\n        output_freq = 0;\n        calc_freq = 0;\n    }\n\n    // =========================\n    // C: MEDIAN FILTER\n    // =========================\n    hist_f3 = hist_f2;\n    hist_f2 = hist_f1;\n    hist_f1 = calc_freq;\n\n    a = hist_f1; b = hist_f2; c = hist_f3;\n\n    median = b;\n    if ((a > b) != (a > c))      median = a;\n    else if ((b > a) != (b > c)) median = b;\n    else                         median = c;\n\n    if (output_mag > 0) {\n        output_freq = median;\n    }\n}\n\n// =================================================\n// OUTPUT\n// =================================================\nfinal_mag = output_mag;\n\n// Attack Mute\nif (stable_counter < lock_frames) final_mag = 0;\n\n// NEU: Wenn Gate zu (Stille), dann Frequenz auf 0 zwingen!\nfinal_freq = output_freq;\nif (final_mag == 0) {\n    final_freq = 0;\n}\r\n\r\n// =================================================\n// FUNDAMENTAL-STATUS (NEU!)\n// =================================================\nhas_fundamental = 0;\n\nif (stable_counter >= lock_frames && final_mag > 0) {\n    has_fundamental = 1;\n}\n\n\nout1 = final_freq;\nout2 = final_mag;\nout3 = stable_counter;\r\nout4 = has_fundamental; "
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "out 9",
                                        "patching_rect": [ 1189.3333687782288, 140.00000417232513, 35.0, 22.0 ],
                                        "numinlets": 1,
                                        "numoutlets": 0,
                                        "id": "obj-12"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "param min_switch_frames 0",
                                        "patching_rect": [ 862.6666923761368, 100.00000298023224, 159.0, 22.0 ],
                                        "numinlets": 0,
