                                        "id": "obj-10",
                                        "fontsize": 12.0,
                                        "outlettype": [ "", "", "", "" ],
                                        "fontname": "<Monospaced>",
                                        "code": "// Eingänge: Die 4 Bins von den vorherigen Codeboxen\nbin1 = in1;\nbin2 = in2;\nbin3 = in3;\nbin4 = in4;\n\n// Bubble-Sort Algorithmus für 4 Werte\ntemp = 0;\n\n// Erster Vergleich (bin1 & bin2)\nif (bin1 > bin2) {\n    temp = bin1;\n    bin1 = bin2;\n    bin2 = temp;\n}\n\n// Zweiter Vergleich (bin2 & bin3)\nif (bin2 > bin3) {\n    temp = bin2;\n    bin2 = bin3;\n    bin3 = temp;\n}\n\n// Dritter Vergleich (bin3 & bin4)\nif (bin3 > bin4) {\n    temp = bin3;\n    bin3 = bin4;\n    bin4 = temp;\n}\n\n// Wiederholung der Vergleiche für Stabilität\nif (bin1 > bin2) {\n    temp = bin1;\n    bin1 = bin2;\n    bin2 = temp;\n}\n\nif (bin2 > bin3) {\n    temp = bin2;\n    bin2 = bin3;\n    bin3 = temp;\n}\n\nif (bin1 > bin2) {\n    temp = bin1;\n    bin1 = bin2;\n    bin2 = temp;\n}\n\n// Ausgänge: Sortierte Bins in aufsteigender Reihenfolge\nout1 = bin1;\nout2 = bin2;\nout3 = bin3;\nout4 = bin4;\n"
                                    }
                                },
