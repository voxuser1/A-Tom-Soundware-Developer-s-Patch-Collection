                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 2198.0, 77.66666769981384, 730.0, 592.0 ],
                                        "numinlets": 5,
                                        "fontface": 0,
                                        "numoutlets": 2,
                                        "id": "obj-33",
                                        "fontsize": 12.0,
                                        "outlettype": [ "", "" ],
                                        "fontname": "<Monospaced>",
                                        "code": "// History Variables (explicit initialization)\nHistory magnitude(0); // Stores the maximum magnitude (excluding the ignored bins)\nHistory index(0); // Stores the index of the fourth loudest bin\nHistory last(0); // Stores the index of the last found bin\n\nframesize_no_mirror = framesize / 2;\n\n// Bins to be ignored (passed from Codebox 1, 2, and 3)\nignore_index_1 = in3;\nignore_index_2 = in4;\nignore_index_3 = in5;\n\n// Tolerance range for neighboring bins (±1)\ntolerance = 1;\n\n// Check if the current bin should be ignored (same or adjacent bin)\nis_ignored = (\nabs(in2 - ignore_index_1) <= tolerance ||\nabs(in2 - ignore_index_2) <= tolerance ||\nabs(in2 - ignore_index_3) <= tolerance ||\nin2 == 0\n);\n\n// Find the next loudest bin (excluding the ignored areas & Bin 0)\nif (!is_ignored && in1 > magnitude && in2 > 0 && in2 < framesize_no_mirror) {\nmagnitude = in1; // Store new maximum magnitude\nindex = in2; // Store the corresponding bin index\n}\n\n// Sample-accurate Reset at the end of the frame\nif (in2 == (framesize_no_mirror - 1)) {\nlast = index; // Output the last found index\nindex = 0; // Reset index\nmagnitude = 0; // Reset magnitude\n}\n\n// Outputs (sample-accurate)\nout1 = last; // Index of the fourth loudest bin\nout2 = magnitude; // Magnitude of the fourth loudest bin"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "out 4",
                                        "patching_rect": [ 2198.0, 700.0, 35.0, 22.0 ],
                                        "numinlets": 1,
                                        "numoutlets": 0,
                                        "id": "obj-16"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "out 3",
                                        "patching_rect": [ 1422.0, 647.6666676998138, 37.0, 22.0 ],
                                        "numinlets": 1,
                                        "numoutlets": 0,
                                        "id": "obj-24"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 1422.0, 74.66666769981384, 766.0, 540.0 ],
                                        "numinlets": 4,
                                        "fontface": 0,
                                        "numoutlets": 2,
                                        "id": "obj-25",
                                        "fontsize": 12.0,
                                        "outlettype": [ "", "" ],
                                        "fontname": "<Monospaced>",
                                        "code": "// History Variables (explicit initialization)\nHistory magnitude(0); // Stores the maximum magnitude (excluding the ignored bins)\nHistory index(0); // Stores the index of the third loudest bin\nHistory last(0); // Stores the index of the last found bin\n\nframesize_no_mirror = framesize / 2;\n\n// Bins to be ignored (passed from Codebox 1 and 2)\nignore_index_1 = in3;\nignore_index_2 = in4;\n\n// Tolerance range for neighboring bins (±1)\ntolerance = 1;\n\n// Check if the current bin should be ignored (same or adjacent bin)\nis_ignored = (abs(in2 - ignore_index_1) <= tolerance) || (abs(in2 - ignore_index_2) <= tolerance) || (in2 == 0);\n\n// Find the next loudest bin (excluding the ignored areas & Bin 0)\nif (!is_ignored && in1 > magnitude && in2 > 0 && in2 < framesize_no_mirror) {\nmagnitude = in1; // Store new maximum magnitude\nindex = in2; // Store the corresponding bin index\n}\n\n// Sample-accurate Reset at the end of the frame\nif (in2 == (framesize_no_mirror - 1)) {\nlast = index; // Output the last found index\nindex = 0; // Reset index\nmagnitude = 0; // Reset magnitude\n}\n\n// Outputs (sample-accurate)\nout1 = last; // Index of the third loudest bin\nout2 = magnitude; // Magnitude of the third loudest bin"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "out 2",
                                        "patching_rect": [ 716.0, 638.0, 37.0, 22.0 ],
                                        "numinlets": 1,
                                        "numoutlets": 0,
                                        "id": "obj-21"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 716.0, 73.33333539962769, 698.0, 541.3333311676979 ],
                                        "numinlets": 3,
                                        "fontface": 0,
                                        "numoutlets": 2,
                                        "id": "obj-19",
                                        "fontsize": 12.0,
                                        "outlettype": [ "", "" ],
                                        "fontname": "<Monospaced>",
                                        "code": "// History Variables (explicit initialization)\nHistory magnitude(0); // Stores the maximum magnitude (excluding the loudest bin)\nHistory index(0); // Stores the index of the next loudest bin\nHistory last(0); // Stores the index of the last found bin\n\nframesize_no_mirror = framesize / 2;\n\n// Incoming data from Codebox 1\nignore_index = in3; // Index of the loudest bin from the first codebox\ntolerance = 1; // Tolerance range for neighboring bins (±1)\n\n// Check if the current bin should be ignored (same or adjacent bin)\nis_ignored = (abs(in2 - ignore_index) <= tolerance || in2 == 0);\n\n// Find the next loudest bin (excluding the ignored area & Bin 0)\nif (!is_ignored && in1 > magnitude && in2 > 0 && in2 < framesize_no_mirror) {\nmagnitude = in1; // Store new maximum magnitude\nindex = in2; // Store the corresponding bin index\n}\n\n// Sample-accurate Reset at the end of the frame\nif (in2 == (framesize_no_mirror - 1)) {\nlast = index; // Output the last found index\nindex = 0; // Reset index\nmagnitude = 0; // Reset magnitude\n}\n\n// Outputs (sample-accurate)\nout1 = last; // Index of the next loudest bin\nout2 = magnitude; // Magnitude of the next loudest bin"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "param framesize 512",
                                        "patching_rect": [ 2816.0, 17.0, 123.0, 22.0 ],
                                        "numinlets": 0,
                                        "numoutlets": 1,
                                        "id": "obj-18",
                                        "outlettype": [ "" ]
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 29.33333420753479, 69.33333539962769, 674.0, 550.0 ],
                                        "numinlets": 2,
                                        "fontface": 0,
                                        "numoutlets": 2,
                                        "id": "obj-8",
                                        "fontsize": 12.0,
                                        "outlettype": [ "", "" ],
                                        "fontname": "<Monospaced>",
                                        "code": "// History Variables\nHistory magnitude(0);  // Stores the current maximum magnitude\nHistory index(0);   // Stores the index of the loudest bin\nHistory last(0);   // Stores the index of the loudest bin at the end of a frame\n\nframesize_no_mirror = framesize / 2; // Nyquist Frequency\n\n// Find the loudest bin, excluding Bin 0\nif (in1 > magnitude && in2 > 0 && in2 < framesize_no_mirror) {\n   magnitude = in1;  // Store new maximum magnitude\n   index = in2;   // Store the corresponding bin index\n}\n\n// Reset at the end of an FFT frame\nif (in2 == (framesize_no_mirror - 1)) {\n    last = index;     // Output the last found index\n    index = 0;         // Reset index\n    magnitude = 0; // Reset magnitude\n}\n\n// Outputs (Sample-accurate)\nout1 = last;                // Index of the loudest bin\nout2 = magnitude;    // Magnitude of the loudest bin"
                                    }
                                },
