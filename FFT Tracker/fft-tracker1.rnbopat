                        "gencode": "Param framesize(512);\nHistory magnitude(0);\nHistory index(0);\nHistory last(0);\nHistory magnitude_1(0);\nHistory index_2(0);\nHistory last_3(0);\nHistory magnitude_4(0);\nHistory index_5(0);\nHistory last_6(0);\nHistory magnitude_7(0);\nHistory index_8(0);\nHistory last_9(0);\nout5 = framesize;\nframesize_no_mirror = framesize / 2;\nif((((in1 > magnitude) && (in2 > 0))) && (in2 < framesize_no_mirror)) {\n\tmagnitude = in1;\n\tindex = in2;\n}\nif(in2 == (framesize_no_mirror - 1)) {\n\tlast = index;\n\tindex = 0;\n\tmagnitude = 0;\n}\nexpr_10 = last;\nexpr_11 = magnitude;\nout1 = expr_10;\nframesize_no_mirror_12 = framesize / 2;\nis_ignored = ((abs(in2 - expr_10)) <= 1) || (in2 == 0);\nif((((((!is_ignored) && (in1 > magnitude_1))) && (in2 > 0))) && (in2 < framesize_no_mirror_12)) {\n\tmagnitude_1 = in1;\n\tindex_2 = in2;\n}\nif(in2 == (framesize_no_mirror_12 - 1)) {\n\tlast_3 = index_2;\n\tindex_2 = 0;\n\tmagnitude_1 = 0;\n}\nexpr_13 = last_3;\nexpr_14 = magnitude_1;\nout2 = expr_13;\nframesize_no_mirror_15 = framesize / 2;\nis_ignored_16 = ((((abs(in2 - expr_10)) <= 1) || ((abs(in2 - expr_13)) <= 1))) || (in2 == 0);\nif((((((!is_ignored_16) && (in1 > magnitude_4))) && (in2 > 0))) && (in2 < framesize_no_mirror_15)) {\n\tmagnitude_4 = in1;\n\tindex_5 = in2;\n}\nif(in2 == (framesize_no_mirror_15 - 1)) {\n\tlast_6 = index_5;\n\tindex_5 = 0;\n\tmagnitude_4 = 0;\n}\nexpr_17 = last_6;\nexpr_18 = magnitude_4;\nout3 = expr_17;\nframesize_no_mirror_19 = framesize / 2;\nis_ignored_20 = ((((((abs(in2 - expr_10)) <= 1) || ((abs(in2 - expr_13)) <= 1))) || ((abs(in2 - expr_17)) <= 1))) || (in2 == 0);\nif((((((!is_ignored_20) && (in1 > magnitude_7))) && (in2 > 0))) && (in2 < framesize_no_mirror_19)) {\n\tmagnitude_7 = in1;\n\tindex_8 = in2;\n}\nif(in2 == (framesize_no_mirror_19 - 1)) {\n\tlast_9 = index_8;\n\tindex_8 = 0;\n\tmagnitude_7 = 0;\n}\nexpr_21 = last_9;\nexpr_22 = magnitude_7;\nout4 = expr_21;",
